#!/bin/zsh
# A raiz do projeto vem da posicao do proprio .app:
# Atalhos/<nome>.app/Contents/MacOS/<exe> -> sobe cinco niveis.
PROJETO="${0:A:h:h:h:h:h}"
RUNNER="$PROJETO/scripts/iniciar-painel.sh"

if [[ ! -x "$RUNNER" ]]; then
  /usr/bin/osascript -e "display alert \"timelapse-studio\" message \"Não achei $RUNNER. O atalho precisa ficar dentro da pasta Atalhos do projeto.\""
  exit 1
fi

"$RUNNER"
RESULT=$?

if (( RESULT == 0 )); then
  /usr/bin/open "http://localhost:8765"
fi

exit "$RESULT"
